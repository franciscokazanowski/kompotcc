# Copie para .env.local apenas se quiser configurar uma instalacao propria.
# Sem URL e chave, a plataforma funciona em demonstracao local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Contato publico do responsavel pela SUA instalacao.
KOMPO_PRIVACY_CONTACT=
ENABLE_EXPERIMENTAL_COREPACK=1
